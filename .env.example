### Public configuration (safe to expose in the browser)
# These NEXT_PUBLIC_ values are bundled into the client. Do not put secrets here.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_CURRENCY=USD
NEXT_PUBLIC_DEFAULT_COUNTRY=
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_SUPPORT_HOURS=
NEXT_PUBLIC_PRODUCT_PRICE=
NEXT_PUBLIC_PRODUCT_COMPARE_PRICE=
NEXT_PUBLIC_SHIPPING_FLAT=
NEXT_PUBLIC_SHIPPING_MESSAGE=
NEXT_PUBLIC_RETURNS_MESSAGE=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_PINTEREST=
NEXT_PUBLIC_SOCIAL_TIKTOK=
WHATSAPP_SUPPORT_NUMBER=
ABANDONED_CART_HOURS=4
FEATURE_WISHLIST=true
FEATURE_BACK_IN_STOCK=true
FEATURE_ABANDONED_CART=true
FEATURE_GIFT_CARD=false
FEATURE_REFERRAL=false
FEATURE_PWA=false

### Shipping (server only)
# Checkout stays closed until SHIPPING_ENABLED=true and SHIPPING_FLAT_MINOR is a whole number of cents.
# An empty amount is not free shipping. 0 means shipping is included in the product price.
# Example: 2000 means 20.00 in the store currency.
SHIPPING_ENABLED=true
SHIPPING_FLAT_MINOR=0
SHIPPING_FREE_THRESHOLD_MINOR=
SHIPPING_ESTIMATE=

### Tax (server only)
# Basis points added on top of the discounted merchandise total. 0 means no tax is collected.
# 800 would mean 8.00%. A stored admin setting overrides this value.
TAX_RATE_BPS=0

### Payment (server only — never prefix these with NEXT_PUBLIC_)
# RAZORPAY_KEY_ID is stored on the server and sent only to the checkout page so Razorpay can open.
# It is not a secret, but it must not be a NEXT_PUBLIC_ variable.
# RAZORPAY_KEY_SECRET and RAZORPAY_WEBHOOK_SECRET must never reach the client.
# Production webhook URL: https://<NEXT_PUBLIC_SITE_URL host>/api/webhooks/razorpay
# Do not register localhost as the production webhook. Required owner values are listed in docs/PRODUCTION.md.
PAYMENT_PROVIDER=
PAYMENT_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_ENVIRONMENT=test

### Email
# resend or smtp. Leave blank until a mailbox is ready. Order mail, password reset, and the contact form stay unsent until this is set.
EMAIL_PROVIDER=
EMAIL_FROM=
EMAIL_FROM_NAME=Rouge Sur Mesure
# Inbox that receives contact-form messages and paid-order notices. Reply from this mailbox reaches the customer.
STORE_OWNER_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
RESEND_API_KEY=

### Database (server only)
# Production uses PostgreSQL. Vercel cannot store prisma/dev.db.
# DATABASE_URL is the pooled connection the app uses at runtime.
# DIRECT_URL is the direct connection Prisma uses for migrations. On Neon or Vercel Postgres, use the unpooled URL.
# A local Postgres can use the same URL for both. Do not commit either value. Do not point production at prisma/dev.db.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

### Authentication
AUTH_SECRET=
# Public Google OAuth client id. Create it in Google Cloud with authorized JavaScript origins for this site.
# The same button creates an account or signs in. Leave blank until the owner adds the real client id.
GOOGLE_CLIENT_ID=
OTP_TTL_MINUTES=10
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5

### Analytics
NEXT_PUBLIC_GA_ID=

### Meta
NEXT_PUBLIC_META_PIXEL_ID=
META_ACCESS_TOKEN=
META_DATASET_ID=
META_API_VERSION=v21.0
META_TEST_EVENT_CODE=
META_ENABLED=
# Protects the daily activity email. Vercel sends this as Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=

### Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
