{
  "name": "yslbeauty",
  "private": true,
  "scripts": {
    "dev": "node --require ./scripts/windows-readlink.cjs ./node_modules/next/dist/bin/next dev",
    "build": "node --require ./scripts/windows-readlink.cjs ./node_modules/next/dist/bin/next build",
    "vercel-build": "prisma generate && prisma migrate deploy && node --require ./scripts/windows-readlink.cjs ./node_modules/next/dist/bin/next build",
    "start": "node --require ./scripts/windows-readlink.cjs ./node_modules/next/dist/bin/next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test:prices": "npx tsx --test tests/price-integrity.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "node prisma/seed.mjs",
    "seed:reviews": "node prisma/seed-reviews.mjs",
    "db:setup": "prisma migrate dev --name init && node prisma/seed.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "country-state-city": "^3.2.1",
    "framer-motion": "^12.23.22",
    "next": "^15.5.4",
    "nodemailer": "^10.0.12",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.36.0",
    "eslint-config-next": "^15.5.4",
    "prisma": "^6.16.2",
    "typescript": "^5.9.2"
  }
}
